{
	"name": "PL_SOURCE_TO_SILVER_MAIN",
	"properties": {
		"activities": [
			{
				"name": "Read metadata table values",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT table_id FROM [ctrl].[table_config] WHERE is_active = 1 AND source_system = '@{pipeline().parameters.param_source_system}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Metadata_Tables",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Iterating over table ids",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read metadata table values",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read metadata table values').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "table_id received",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_id",
								"value": {
									"value": "@item().table_id",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"param_source_system": {
				"type": "String",
				"defaultValue": "neon_postgres"
			}
		},
		"variables": {
			"table_id": {
				"type": "String"
			}
		},
		"annotations": []
	}
}