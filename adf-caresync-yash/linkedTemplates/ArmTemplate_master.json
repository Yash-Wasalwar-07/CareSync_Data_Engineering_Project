{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-yash"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresyncyash.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-2032493"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Yash"
		},
		"LS_DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sacaresyncyash.dfs.core.windows.net/"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-key-vault-yash.vault.azure.net/"
		},
		"LS_Postgres_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-lingering-pine-b5n1rgz4-pooler.c-7.us-east-2.aws.neon.tech"
		},
		"LS_Postgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_Postgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync-yash_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_DataLake_properties_typeProperties_url": {
						"value": "[parameters('LS_DataLake_properties_typeProperties_url')]"
					},
					"LS_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_userName')]"
					},
					"LS_Postgres_properties_typeProperties_server": {
						"value": "[parameters('LS_Postgres_properties_typeProperties_server')]"
					},
					"LS_Postgres_properties_typeProperties_database": {
						"value": "[parameters('LS_Postgres_properties_typeProperties_database')]"
					},
					"LS_Postgres_properties_typeProperties_username": {
						"value": "[parameters('LS_Postgres_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}